# ===== AWS Configuration =====

# Region - us-east-1 recommended for Bedrock model availability
AWS_REGION=us-east-1

# IAM User credentials (create in AWS Console > IAM > Users)
# Required policies: AmazonBedrockFullAccess, AmazonSNSFullAccess
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ===== OpenWeatherMap =====
# Free API key from https://openweathermap.org/api
# Required for real 7-day weather on the Weather screen
OPENWEATHER_API_KEY=

# ===== Groq (AI chat + crop image analysis) =====
# Get a free API key: https://console.groq.com → Sign up → API Keys → Create API Key
# Used for: AI Chat (when toggled), and AI Crop Doctor image analysis (vision)
GROQ_API_KEY=

# ===== data.gov.in (Mandi prices) =====
# Free API key from https://data.gov.in
# Required for live mandi prices on the Market screen
DATA_GOV_IN_API_KEY=
